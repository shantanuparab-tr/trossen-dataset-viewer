# Where your data lives on this machine. Both are mounted read-only.
VIZ_DATASETS_DIR=/path/to/converted          # holds <org>/<dataset>/meta/info.json
VIZ_MCAP_DIR=/path/to/raw_mcap               # holds <dataset>/<run>/episode_*.mcap

# Port the UI is served on.
VIZ_UI_PORT=3000

# Host directories exposed read-only so roots added from the Dataset folders
# panel resolve inside the container. Defaults cover a NAS mount under /mnt and
# a USB stick under /media; point them at an empty directory to expose nothing.
# VIZ_MOUNTS_DIR=/mnt
# VIZ_REMOVABLE_DIR=/media

# Only needed when you mount more than one dataset tree: mount them under
# /data/ and list them here, colon-separated.
# VIZ_DATASET_ROOTS=/data/datasets:/data/datasets-extra
